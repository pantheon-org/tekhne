.tokensave/
# Ignore aislop local state but keep the committed config (scan excludes) so CI
# reads it; baseline.json / session.jsonl / history.jsonl stay ignored.
# The root rule is anchored to the repo root; the `**` rule also catches the
# nested `.aislop/` directories aislop creates when it scans subdirectories.
.aislop/*
**/.aislop/*
!.aislop/config.yml
.tmp/

# Generated by running tools (terragrunt, terraform, python); never commit these.
# scripts/check-no-cache-files.sh also rejects them at commit time, which covers a
# forced add. node_modules/ is ignored above.
.terragrunt-cache/
.terraform/
__pycache__/
.pytest_cache/
.cache/
.venv/
